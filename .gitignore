# Real Kubernetes secrets — never commit these
# Safe counterparts are *.example.yaml and *.template.yaml in the same directories
**/secrets.yaml
**/secret.yaml
**/pgbouncer-secret.yaml
**/*-secret.yaml
**/*-secrets.yaml

# Local env / credential files (defense in depth)
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig
**/credentials.json
id_rsa
id_ed25519
*.p12
*.pfx

# Scratch / debug artifacts
tmp-*
tmp_*

# Landing deploy manifests tracked in stayledger-landing repo (not infra)
stayledger-landing/

# Keep example/template files (must come after ignore rules)
!**/*.example.yaml
!**/*.template.yaml
